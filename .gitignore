# =================================### 编译输出 (Build Outputs)
# =================================
# 排除所有目标文件、静态库和动态库
*.o
*.obj
*.lib
*.a
*.dll
*.so
*.so.*
*.dylib
*.exe
*.out
*.app

# CUDA 特有的中间文件
*.ptx
*.cubin
*.fatbin

# =================================
# ### 构建目录 (Build Directories)
# =================================
# 建议在项目根目录下使用 build 文件夹进行编译
build/
bin/
lib/
dist/

# =================================
# ### CMake 缓存与中间文件
# =================================
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json

# =================================
# ### IDE & 编辑器配置 (IDE Specific)
# =================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Visual Studio
.vs/
*.sln
*.vcxproj
*.user

# CLion / JetBrains
.idea/
cmake-build-*/

# =================================
# ### 日志与临时文件 (Logs & Temp)
# =================================
*.log
*.tmp
*.swp
.DS_Store

# =================================
# ### 性能分析数据 (Profiling Data)
# =================================
# NVIDIA Nsight / nvprof 输出
*.nvprof
*.nsys-rep
*.qdrep